{
  "info": {
    "name": "LocaFlix",
    "description": "Crie o plano, o usuário e faça login. O login grava token. Aluguel exige Authorization Bearer. Create plan grava planId, Create user grava userId e Create movie grava movieId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "planId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "movieId",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "rentalId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Plans",
      "item": [
        {
          "name": "Create plan",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('planId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Basico\",\n  \"allowedRentalQuantity\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/plans"
          }
        },
        {
          "name": "List plans",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/plans"
          }
        },
        {
          "name": "Get plan",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/plans/{{planId}}"
          }
        },
        {
          "name": "Update plan",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Plus\",\n  \"allowedRentalQuantity\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/plans/{{planId}}"
          }
        },
        {
          "name": "Delete plan",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/plans/{{planId}}"
          }
        }
      ]
    },
